# Copy this file to secrets.toml for local Streamlit testing.
# Never commit secrets.toml or real API keys.
MISTRAL_API_KEY = "your_mistral_api_key"
# Optional: paste Netscape-format YouTube cookies for videos requiring sign-in.
# YOUTUBE_COOKIES = "# Netscape HTTP Cookie File\n..."
# Recommended for multiline cookies in Streamlit:
# YOUTUBE_COOKIES_B64 = "base64-encoded-cookie-file"
# Optional for cloud IP blocks; use a real URL with scheme and port:
# YOUTUBE_PROXY = "https://user:password@proxy-host:port"
